// סכמת בסיס הנתונים המלאה של המערכת.
// כברירת מחדל מוגדר SQLite כדי שתוכל להריץ מקומית בלי שום שירות חיצוני.
// לפני עלייה לאוויר עם משתמשים אמיתיים, מומלץ לעבור ל-Postgres (למשל Supabase / Neon / Railway):
// שנה provider ל-"postgresql" ו-url ל-env("DATABASE_URL") עם מחרוזת חיבור אמיתית.

// הערה: השדות למטה מוגדרים כ-String עם הערה על הערכים האפשריים - זה עובד
// מצוין גם ב-Postgres, ומאפשר להישאר תואם למבנה שהיה בגרסת הפיתוח.
// אם תרצה enum אמיתי ברמת בסיס הנתונים בהמשך, אפשר להחליף בקלות.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String? // ריק אם ההתחברות נעשית דרך גוגל בלבד
  googleId      String?   @unique
  createdAt     DateTime  @default(now())
  isBlocked     Boolean   @default(false)

  ownedForums   Forum[]        @relation("ForumOwner")
  memberships   ForumMember[]
  threads       Thread[]
  posts         Post[]
}

// רמת חשיפה לחברים רשומים בפורום
// רמת חשיפה למבקרים שאינם חברים
model Forum {
  id             String        @id @default(cuid())
  title          String
  description    String?
  ownerId        String
  owner          User          @relation("ForumOwner", fields: [ownerId], references: [id])
  memberAccess   String        @default("VIEW_AND_EDIT") // VIEW_ONLY | VIEW_AND_EDIT
  visitorAccess  String        @default("VIEW_ONLY") // NONE | VIEW_ONLY | VIEW_AND_COMMENT
  isBlocked      Boolean       @default(false) // חסימה על ידי מנהל-על
  createdAt      DateTime      @default(now())

  members        ForumMember[]
  threads        Thread[]
  invites        Invite[]
}

model ForumMember {
  id            String     @id @default(cuid())
  forumId       String
  userId        String
  role          String     @default("MEMBER") // OWNER | MEMBER
  notifyOnReply Boolean    @default(true)  // מייל על כל תגובה בפורום
  notifyOnMention Boolean  @default(true)  // מייל כשמישהו מגיב ישירות לחבר
  joinedAt      DateTime   @default(now())

  forum         Forum      @relation(fields: [forumId], references: [id])
  user          User       @relation(fields: [userId], references: [id])

  @@unique([forumId, userId])
}

model Invite {
  id        String   @id @default(cuid())
  forumId   String
  email     String
  name      String?
  token     String   @unique
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  forum     Forum    @relation(fields: [forumId], references: [id])
}

model Thread {
  id          String   @id @default(cuid())
  forumId     String
  title       String
  authorId    String
  isBlocked   Boolean  @default(false) // חסימת שיחה שלמה על ידי מנהל
  createdAt   DateTime @default(now())

  forum       Forum    @relation(fields: [forumId], references: [id])
  author      User     @relation(fields: [authorId], references: [id])
  posts       Post[]
}

model Post {
  id          String   @id @default(cuid())
  threadId    String
  authorId    String
  contentHtml String   // תוכן עשיר (HTML) מהעורך
  isBlurred   Boolean  @default(false) // טשטוש מילים על ידי מנהל
  createdAt   DateTime @default(now())

  thread      Thread   @relation(fields: [threadId], references: [id])
  author      User     @relation(fields: [authorId], references: [id])
}

model Advertisement {
  id        String   @id @default(cuid())
  type      String   // IMAGE | VIDEO | LINK
  url       String   // קישור לקובץ (תמונה/וידאו) או לינק חיצוני
  linkUrl   String?  // קישור יעד בעת לחיצה
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())
}
