// סכמת בסיס הנתונים המלאה של המערכת - Postgres דרך Prisma.
// השדות "מצב" (status/role/access) מוגדרים כ-String עם הערה על הערכים
// האפשריים, כדי להישאר גמיש; ה-app הוא זה ששומר על תקינות הערכים.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String? // ריק אם ההתחברות נעשית דרך גוגל בלבד
  googleId      String?   @unique
  createdAt     DateTime  @default(now())
  isBlocked     Boolean   @default(false)

  // פרופיל אישי - מוגדר במסך ה-onboarding מיד לאחר הרשמה
  displayName   String?   @unique // השם שמוצג בפורומים - חובה, ייחודי
  avatarUrl     String?             // תמונת פרופיל (data URL) - אם לא נבחרה, נשתמש בצבע
  avatarColor   String?             // צבע רקע לעיגול ברירת מחדל (כמו בגוגל)
  bio           String?             // תיאור קצר, עד 40 תווים (נאכף באפליקציה)
  onboarded     Boolean   @default(false)

  ownedForums     Forum[]        @relation("ForumOwner")
  memberships     ForumMember[]
  threads         Thread[]
  posts           Post[]
  joinRequests    JoinRequest[]
}

model Forum {
  id                  String        @id @default(cuid())
  title               String
  description         String?
  ownerId             String
  owner               User          @relation("ForumOwner", fields: [ownerId], references: [id])
  memberAccess        String        @default("VIEW_AND_EDIT") // VIEW_ONLY | VIEW_AND_EDIT
  visitorAccess       String        @default("VIEW_ONLY") // NONE | VIEW_ONLY | VIEW_AND_COMMENT
  visitorTitleVisible Boolean       @default(true) // האם מבקרים שאינם חברים רואים את כותרת האשכולות או שהיא מטושטשת
  allowJoinRequests   Boolean       @default(false) // האם מבקרים יכולים לשלוח בקשת הצטרפות למנהל
  isBlocked           Boolean       @default(false) // חסימה על ידי מנהל-על
  createdAt           DateTime      @default(now())

  members       ForumMember[]
  threads       Thread[]
  invites       Invite[]
  joinRequests  JoinRequest[]
}

model ForumMember {
  id              String     @id @default(cuid())
  forumId         String
  userId          String
  role            String     @default("MEMBER") // OWNER | ADMIN | MEMBER
  notifyOnReply   Boolean    @default(true)
  notifyOnMention Boolean    @default(true)
  joinedAt        DateTime   @default(now())

  forum           Forum      @relation(fields: [forumId], references: [id])
  user            User       @relation(fields: [userId], references: [id])

  @@unique([forumId, userId])
}

model Invite {
  id        String   @id @default(cuid())
  forumId   String
  email     String
  name      String?
  token     String   @unique
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  forum     Forum    @relation(fields: [forumId], references: [id])
}

// "אשכול" = שרשור/דיון בתוך פורום
model Thread {
  id          String   @id @default(cuid())
  forumId     String
  title       String
  authorId    String
  tags        String[] @default([]) // תגיות מתוך רשימה מוגדרת מראש (ראה lib/tags.ts)
  isBlocked   Boolean  @default(false) // חסימת אשכול שלם על ידי מנהל
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt // ברירת מחדל מאפשרת הוספת העמודה גם לטבלה עם שורות קיימות, בלי לאבד מידע

  forum       Forum    @relation(fields: [forumId], references: [id])
  author      User     @relation(fields: [authorId], references: [id])
  posts       Post[]
}

model Post {
  id            String   @id @default(cuid())
  threadId      String
  authorId      String
  contentHtml   String   // תוכן עשיר (HTML) מהעורך
  replyToPostId String?  // אם זו תגובה ישירה להודעה ספציפית - ה-id שלה
  attachments   String[] @default([]) // קבצים מצורפים (data URL לכל קובץ)
  isBlurred     Boolean  @default(false) // טשטוש תוכן על ידי מנהל
  createdAt     DateTime @default(now())

  thread        Thread   @relation(fields: [threadId], references: [id])
  author        User     @relation(fields: [authorId], references: [id])
}

// בקשת הצטרפות לפורום סגור, נשלחת ממבקר (שאינו חבר) למנהל/י הפורום
model JoinRequest {
  id          String   @id @default(cuid())
  forumId     String
  userId      String
  message     String
  attachments String[] @default([])
  status      String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt   DateTime @default(now())

  forum       Forum    @relation(fields: [forumId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

// פנייה כללית למערכת דרך כפתור "יצירת קשר" - נצפית במסך הניהול (F8)
model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  message     String
  attachments String[] @default([])
  createdAt   DateTime @default(now())
}

// הגדרות אתר גלובליות - שורה יחידה (id קבוע)
model SiteSettings {
  id                  Int     @id @default(1)
  classifiedsEnabled  Boolean @default(true) // האם לוח המודעות מוצג בצד הפורומים
}

model Advertisement {
  id        String   @id @default(cuid())
  type      String   // IMAGE | VIDEO | LINK
  url       String   // data URL של הקובץ, או קישור חיצוני
  linkUrl   String?  // קישור יעד בעת לחיצה
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())
}
